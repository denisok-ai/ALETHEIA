# Пример unit для единственного экземпляра Next.js на VPS.
# Скопируйте в /etc/systemd/system/aletheia.service, поправьте пути и пользователя.
#
#   sudo cp scripts/systemd/aletheia.service.example /etc/systemd/system/aletheia.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now aletheia.service
#
# Важно: WorkingDirectory и префикс npm должны указывать на ОДИН каталог с актуальным .next
# (не дублируйте проект в /var/www и /opt одновременно с двумя сервисами).

[Unit]
Description=AVATERRA Next.js (ALETHEIA)
After=network.target
# Лимит рестартов ОТКЛЮЧЁН (14.08.2026): при CI-автодеплое приложение
# останавливается/стартует несколько раз, а два деплоя подряд превысили прежний
# лимит 5/300с → systemd отказался стартовать (start-limit-hit) и прод лёг.
# Деплой обязан всегда поднимать сервис; реальные краши ловят Restart=always,
# deadman-таймер деплоя (deploy-rsync-from-local.sh) и мониторинг.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ALETHEIA
Environment=NODE_ENV=production
Environment=TZ=Europe/Moscow
# Рекомендуется: один и тот же .env, что при ручном запуске скриптов из /opt/ALETHEIA
# (иначе импорт правит prisma/dev.db в /opt, а сервис стартует из другого каталога / с другим DATABASE_URL).
EnvironmentFile=-/opt/ALETHEIA/.env
Environment=NODE_OPTIONS=--max-old-space-size=512
# Слушать только localhost — снаружи доступ через nginx :443
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start
# Автоперезапуск при краше/OOM (проверено: kill -9 → сервис поднимается за ~5с)
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
