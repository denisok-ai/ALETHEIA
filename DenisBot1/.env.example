# Core
APP_ENV=production
APP_DEBUG=false
TZ=Europe/Moscow

# Telegram
BOT_TOKEN=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_TOKEN=
TARGET_CHANNEL_ID=
# Админы бота (через запятую). Для admin_preview — получатели постов на проверку.
ADMIN_TELEGRAM_IDS=337952743,368722371,459494305
# Не слать предпросмотр постов (бот Avaterra, PostX и др.)
ADMIN_PREVIEW_EXCLUDE_IDS=8660626182,7679088857

# AI Providers
DEEPSEAK_API_KEY=
DEEPSEAK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7

KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=flux-kontext-pro
KIE_IMAGE_SIZE=3:4
KIE_POLL_INTERVAL_SECONDS=4
KIE_POLL_TIMEOUT_SECONDS=180

# Publication
# PUBLISH_MODE: channel (автопост в канал) | admin_preview (текст админам в личку)
PUBLISH_MODE=admin_preview
# IMAGE_GENERATION_ENABLED: false — без KIE, посты text-only
IMAGE_GENERATION_ENABLED=false
PUBLISH_HOUR=11
PUBLISH_MINUTE=0
# Задержка (сек) между отправкой картинки и текстового сообщения.
# Картинка идёт без caption, чтобы Telegram не обрезал текст до 1024 символов.
PUBLISH_TEXT_DELAY_SECONDS=10
# Лид-воронка выключена: трафик уходит в бота портала @AvaterraProBot
FUNNEL_ENABLED=false
PORTAL_BOT_USERNAME=AvaterraProBot
ENABLE_AUTO_PUBLISH=false
# Лид-воронка выключена: трафик уходит в бота портала (см. PORTAL_BOT_USERNAME)
FUNNEL_ENABLED=false
PORTAL_BOT_USERNAME=AvaterraProBot
DRY_RUN=true
WEEKLY_PLANNER_ENABLED=true

# Database (PostgreSQL)
POSTGRES_DB=avaterra
POSTGRES_USER=avaterra
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://avaterra:CHANGE_ME@postgres:5432/avaterra

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Scheduler / retry
SCHEDULER_ENABLED=true
CONTENT_GENERATION_RETRY_MAX=5
CONTENT_GENERATION_RETRY_BASE_MS=1000

# Logging
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7

# Deduplication
DEDUP_LOOKBACK_POSTS=60
DEDUP_JACCARD_THRESHOLD=0.55
DEDUP_KEYWORD_OVERLAP_THRESHOLD=0.7

# Knowledge base / quality / image backup
KB_YAML_PATH=knowledge/avaterra.yaml
POSTS_PER_WEEK=7
QUALITY_ENABLED=true
QUALITY_MAX_RETRIES=2
WEEKLY_PIPELINE_EXTRA_PASSES=2
WEEKLY_PIPELINE_PASS_DELAY_SECONDS=45
WEEKLY_PIPELINE_NOTIFY_ADMINS=true
IMAGE_BACKUP_ENABLED=true
IMAGE_BACKUP_DIR=/app/runtime/images

# --- Откат к автопубликации в канал ---
# PUBLISH_MODE=channel
# IMAGE_GENERATION_ENABLED=true
# ENABLE_AUTO_PUBLISH=true
# DRY_RUN=false
# TARGET_CHANNEL_ID=<ваш канал>
# docker compose restart bot
