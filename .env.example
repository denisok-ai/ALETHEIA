# Обязательные переменные (только здесь, не переносятся в админку):
# - DATABASE_URL — Prisma подключается до чтения БД
# - NEXTAUTH_SECRET — ключ шифрования секретов в БД (минимум 32 символа)

# База данных (SQLite локально — один файл; настройки портала в таблице SystemSetting в этом же файле)
DATABASE_URL="file:./dev.db"
# На VPS с SQLite (единый файл с Prisma и sqlite3) — абсолютный путь, см. docs/Production-Server.md §5:
# DATABASE_URL="file:/opt/ALETHEIA/prisma/dev.db"

# NextAuth: секрет подписи сессий
NEXTAUTH_SECRET=your_random_secret_min_32_chars

# Опционально для первого старта / импорта в БД (см. Портал → Настройки → импорт из env, docs/Env-Config.md):
# NEXT_PUBLIC_URL=  RESEND_FROM=  RESEND_NOTIFY_EMAIL=  RESEND_API_KEY=
# Приёмка через Mail.ru (SMTP) без Resend — пароль только «для внешнего приложения», см. docs/Env-Config.md:
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=your@mail.ru
# SMTP_PASSWORD=
# SMTP_SECURE=true
# PAYKEEPER_SERVER= PAYKEEPER_LOGIN= PAYKEEPER_PASSWORD= PAYKEEPER_SECRET=
# NEXTAUTH_URL=  # опционально: основной источник — БД (ключ nextauth_url в Портал → Настройки). В .env — только до импорта или если в БД пусто; см. docs/Env-Config.md § NEXTAUTH_URL
# CRON_SECRET=  TELEGRAM_BOT_TOKEN=  TELEGRAM_WEBHOOK_SECRET=  TELEGRAM_ADMIN_CHAT_IDS=
# Telegram long-polling (prod worker aletheia-telegram-poll.service):
# TELEGRAM_POLL_STATE_DIR=/var/lib/aletheia   # offset getUpdates (telegram-poll-offset.json)
# TELEGRAM_API_TIMEOUT_MS=8000                # timeout исходящих вызовов Bot API (не long-poll getUpdates)
# DEEPSEEK_API_KEY=  OPENAI_API_KEY=
#
# --- SMM / Site Radar (единый бот @AvaterraProBot, worker aletheia-jobs.service) ---
# CONTENT_CHANNEL_ID=              # Telegram-канал для публикации (@channel или -100…)
# TARGET_CHANNEL_ID=               # alias (совместимость с DenisBot1)
# CONTENT_DRY_RUN=true             # по умолчанию: превью админам, без автопостинга
# CONTENT_AUTO_PUBLISH=false       # /auto включает автопубликацию в канал
# CONTENT_PAUSED=false
# CONTENT_POSTS_PER_WEEK=7
# CONTENT_PUBLISH_HOUR=11
# CONTENT_PUBLISH_MINUTE=0
# CONTENT_DEDUP_LOOKBACK=60
# CONTENT_DEDUP_JACCARD=0.55
# CONTENT_DEDUP_KEYWORD=0.7
# CONTENT_QUALITY_MAX_RETRIES=2
# KB_YAML_PATH=content/avaterra.yaml
# IMAGE_GENERATION_ENABLED=false   # KIE/Flux — Фаза 4, пока стаб
# KIE_API_KEY=
# Исходящий прокси для Telegram Bot API (если с VPS недоступен api.telegram.org): HTTPS_PROXY=http://127.0.0.1:8080
# PORTAL_TITLE=  COMPANY_LEGAL_ADDRESS=  CONTACT_PHONE=  SCORM_MAX_SIZE_MB=
#
# URL оформления курса (кнопки CTA, блог, чат {{COURSE_URL}}). Если не задан — используется /#pricing на сайте.
# NEXT_PUBLIC_COURSE_CHECKOUT_URL=https://example.com/checkout

# Все операционные настройки после импорта или ручного ввода хранятся в БД (Портал → Настройки).

# Реквизиты оператора персональных данных (публичные страницы /privacy, /pd-consent, футер)
# NEXT_PUBLIC_PDN_OPERATOR_NAME=Индивидуальный предприниматель Стрельцова Татьяна …
# NEXT_PUBLIC_PDN_OPERATOR_INN=
# NEXT_PUBLIC_PDN_OPERATOR_OGRNIP=
# NEXT_PUBLIC_PDN_OPERATOR_ADDRESS=125167, г. Москва, ул. Здоровья, д. 10
# NEXT_PUBLIC_PDN_DPO_EMAIL=support@avaterra.pro

# Публичные счётчики: Google Analytics и Microsoft Clarity в layout не подключаются (см. docs/Personal-Data-RKN-Checklist.md).
# Яндекс.Метрика — только после «Принять аналитику» в баннере cookie (NEXT_PUBLIC_YANDEX_METRIKA_ID).
# NEXT_PUBLIC_YANDEX_METRIKA_ID=108390990
# NEXT_PUBLIC_YANDEX_VERIFICATION=0dec6f2dc03cbfd9
# Опционально: мета-тег для Google Search Console (если выбрали способ «HTML-тег»)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Автономная почта @avaterra.pro (Mailcow рядом с приложением — см. docs/Mail-Server.md)
# -----------------------------------------------------------------------------
# MAIL_PROVISIONING_MODE=mailcow   # mailcow | none — создание ящиков через Mailcow API или только запись в БД
# MAIL_DOMAIN=avaterra.pro
# MAIL_IMAP_HOST=mail.avaterra.pro
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=mail.avaterra.pro
# MAIL_SMTP_PORT=587
# MAILCOW_API_URL=https://mail.avaterra.pro
# MAILCOW_API_KEY=
# Проверка TLS-сертификата почтового сервера (IMAP+SMTP). По умолчанию true (строго).
# На проде avaterra.pro у mail.avaterra.pro нормальный Let's Encrypt (certbot на хосте +
# deploy-hook копирует его в mailcow, см. docs/Mail-Server.md) — оставляем строго (true).
# Обходной =false нужен ТОЛЬКО если dovecot отдаёт самоподписанный (snakeoil при SKIP_LETS_ENCRYPT
# без внешнего сертификата):
# MAIL_IMAP_TLS_REJECT_UNAUTHORIZED=false
# Транзакционная почта через свой Mailcow (перебивает старый SMTP/приоритет Resend, см. lib/email.ts):
# MAIL_USE_OWN_SMTP=true
# EMAIL_TRANSPORT=smtp
# MAIL_SMTP_USER=notifications@avaterra.pro
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_SECURE=
