{
  "name": "avaterra-course",
  "version": "3.6.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cross-env NEXTAUTH_URL=http://localhost:4000 next dev -p 4000",
    "dev:turbo": "cross-env NEXTAUTH_URL=http://localhost:4000 next dev --turbo -p 4000",
    "dev:flex": "next dev",
    "dev:lan": "cross-env NEXTAUTH_URL=http://localhost:3001 next dev -p 3001 -H 0.0.0.0",
    "dev:share": "concurrently -n web,tunnel -c cyan,magenta \"npm run dev\" \"npx --yes cloudflared tunnel --url http://127.0.0.1:4000 --protocol http2\"",
    "dev:tunnel": "npx --yes cloudflared tunnel --url http://127.0.0.1:4000 --protocol http2",
    "dev:share:lt": "concurrently -n web,tunnel -c cyan,magenta \"npm run dev\" \"npx --yes localtunnel --port 4000\"",
    "dev:webpack": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "dev:debug:seed": "npm run db:seed && npm run dev:debug",
    "dev:clean": "node scripts/clean-next.mjs && cross-env NEXTAUTH_URL=http://localhost:4000 next dev -p 4000",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:upsert-comms-templates": "tsx scripts/upsert-default-message-templates.ts",
    "db:upsert-payment-email-templates": "tsx scripts/upsert-payment-email-templates.ts",
    "certificates:export-samples": "tsx scripts/export-sample-certificates.ts",
    "certificates:upsert-showcase-templates": "tsx scripts/upsert-showcase-certificate-templates.ts",
    "certificates:package-assets": "tsx scripts/package-certificate-assets.ts",
    "certificates:optimize-logo": "tsx scripts/optimize-certificate-logo.ts",
    "db:fix-verification-urls": "tsx scripts/fix-verification-material-urls.ts",
    "scorm:import-demo": "tsx scripts/import-demo-scorm.ts",
    "scorm:enroll-demo": "tsx scripts/enroll-demo-scorm-student.ts",
    "scorm:import-new": "tsx scripts/import-scorm-new-course.ts",
    "scorm:setup-probnyy-2": "tsx scripts/setup-scorm-probnyy-2.ts",
    "scorm:patch-overrides": "tsx scripts/patch-existing-scorm-overrides.ts",
    "services:export": "tsx scripts/export-services.ts",
    "services:import-replace": "tsx scripts/import-services-replace.ts",
    "services:export-courses-sync": "tsx scripts/export-courses-and-services-for-prod.ts",
    "services:import-courses-sync": "tsx scripts/import-courses-and-services-merge.ts",
    "prod:readiness": "tsx scripts/prod-readiness-check.ts",
    "verify:mail-module": "tsx scripts/mail-module-verify.ts",
    "mailbox:set-password": "tsx scripts/mailbox-password-set.ts",
    "smtp:set-password": "tsx scripts/smtp-system-password-set.ts",
    "prod:prepare": "npm run prod:readiness && npm run predeploy",
    "db:clean-seed": "tsx scripts/clean-seed-test-data.ts",
    "db:clear-test-batch": "tsx scripts/clear-test-data-batch.ts",
    "db:clean-local-test": "tsx scripts/clear-local-test-data-keep-courses-services.ts",
    "db:check-notifications-enrollment": "tsx scripts/check-notification-enrollment-config.ts",
    "db:clear-crm-users": "tsx scripts/clear-crm-and-users.ts",
    "db:backfill-leads-from-orders": "tsx scripts/backfill-leads-from-orders.ts",
    "db:only-demo-course": "tsx scripts/delete-courses-except.ts",
    "db:delete-courses-not-in-services": "tsx scripts/delete-courses-not-in-services.ts",
    "db:clear-mediateka": "tsx scripts/clear-mediateka.ts",
    "db:delete-seed-groups": "tsx scripts/delete-seed-course-user-groups.ts",
    "prod:diagnostics": "bash scripts/prod-diagnostics.sh",
    "prod:timezone-moscow": "bash scripts/prod-set-timezone-moscow-remote.sh",
    "test:paykeeper": "tsx scripts/paykeeper-protocol-check.ts",
    "test:payment-flow": "tsx scripts/payment-flow-check.ts",
    "paykeeper:debug": "tsx scripts/paykeeper-debug-flow.ts",
    "db:studio": "prisma studio",
    "build": "next build",
    "build:clean": "node scripts/clean-next.mjs && next build",
    "build:server": "NODE_OPTIONS='--max-old-space-size=1536' next build",
    "start": "next start",
    "start:debug": "NODE_OPTIONS='--inspect' next start",
    "lint": "next lint",
    "predeploy": "npm run lint && npm run build",
    "deploy:remote": "bash scripts/deploy-remote.sh",
    "deploy:prod": "bash scripts/push-and-deploy-prod.sh",
    "deploy:rsync": "bash scripts/deploy-rsync-from-local.sh",
    "mailcow:apply-branding": "bash scripts/mailcow-apply-branding-remote.sh",
    "mail:e2e-selfcheck": "bash scripts/mail-e2e-selfcheck-remote.sh",
    "deploy:rsync:with-db": "bash -c 'DEPLOY_COPY_LOCAL_DB=1 bash scripts/deploy-rsync-from-local.sh'",
    "prod:import-courses-services": "bash scripts/run-prod-import-courses-services.sh",
    "telegram:setup-webhook": "tsx scripts/setup-telegram-webhook.ts"
  },
  "dependencies": {
