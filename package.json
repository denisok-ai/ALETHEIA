    "@react-pdf/renderer": "^4.3.2",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.2",
    "framer-motion": "^11.11.17",
    "grammy": "^1.41.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.3.2",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "mailparser": "^3.9.8",
    "nanoid": "^5.1.6",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.13",
    "plyr": "^3.8.4",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-email": "^5.2.9",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^9.0.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.8.0",
    "resend": "^4.0.1",
    "sanitize-html": "^2.17.3",
    "scorm-again": "^3.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "undici": "^6.25.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fontkit": "^2.0.4",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
