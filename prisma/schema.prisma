// AVATERRA — локальная БД (SQLite, без Docker)
// Финальный прод: PostgreSQL (сменить provider на postgresql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile                    Profile?
  enrollments                Enrollment[]
  certificates               Certificate[]
  notifications              Notification[]
  tickets                    Ticket[]                            @relation("UserTickets")
  managedTickets             Ticket[]                            @relation("ManagerTickets")
  scormProgress              ScormProgress[]
  userEnergy                 UserEnergy?
  gamificationXpEvents       GamificationXpEvent[]
  phygitalVerifications      PhygitalVerification[]
  orders                     Order[]
  publicationComments        PublicationComment[]
  mailingsCreated            Mailing[]
  mailingLogs                MailingLog[]
  notificationLogs           NotificationLog[]
  visitLogs                  VisitLog[]
  userGroups                 UserGroup[]
  passwordTokens             PasswordToken[]
  emailVerificationTokens    EmailVerificationToken[]
  aiTutorConversations       AiTutorConversation[]
  verificationThreadComments PhygitalVerificationThreadComment[]
  inboundMessages            InboundMessage[]
  emailDeliveryLogs          EmailDeliveryLog[]
  paymentLinks               PaymentLink[]
}

// Иерархические группы для модулей Курсы, Медиатека, Пользователи
model Group {
  id                String   @id @default(cuid())
  name              String
  description       String?
  parentId          String?
  parent            Group?   @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Group[]  @relation("GroupHierarchy")
  moduleType        String // course | media | user
  type              String   @default("static") // static | dynamic
  accessType        String   @default("common") // common | personal
  displayOrder      Int      @default(0)
  // Специфичные для Медиатеки (используются при moduleType=media)
  smallIcon         String?
  largeIcon         String?
  showSubgroupsMode String? // list | icons
  sourceCourseId    String? // если группа медиа создана автоматически по курсу
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  courseGroups CourseGroup[]
  mediaGroups  MediaGroup[]
  userGroups   UserGroup[]

  @@index([parentId])
  @@index([moduleType])
}

model CourseGroup {
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([courseId, groupId])
  @@index([groupId])
}

model MediaGroup {
  mediaId   String
  media     Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  @@id([mediaId, groupId])
  @@index([groupId])
}

model UserGroup {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     String   @default("member") // member | moderator (для наследования прав на дочерние группы)
  joinedAt DateTime @default(now())

  @@id([userId, groupId])
  @@index([groupId])
}

model VisitLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt        DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  logoutAt       DateTime?
  ipAddress      String?
  userAgent      String?

  @@index([userId])
  @@index([loginAt])
  @@index([lastActivityAt])
  @@index([logoutAt])
  // Ping-хартбит портала бьёт по (userId, logoutAt: null) каждые 120 секунд на
  // каждого залогиненного. Раздельные индексы выше здесь не помогают —
  // планировщик возьмёт только один из них.
  @@index([userId, logoutAt])
}

model Profile {
  id              String    @id
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String    @default("user") // user, manager, admin
  status          String    @default("active") // active, archived
  displayName     String?
  email           String?
  avatarUrl       String?
  telegramId      Int?
  emailVerifiedAt DateTime? // null = не верифицирован
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Уникальность telegramId проверялась только в коде — тремя независимыми
  // «прочитал, потом записал» без транзакции (профиль пользователя, админка,
  // привязка через бота). Два параллельных запроса проходили проверку оба, и
  // один Telegram-аккаунт оказывался привязан к двум профилям: поиск по
  // telegramId возвращал произвольный из них, то есть бот мог показать чужие
  // курсы и уведомления. Индекс заодно убирает скан Profile на каждое
  // входящее сообщение бота.
  // Проверено на проде: дублей нет (привязок всего 2), применяется чисто.
  // NULL в SQLite между собой не конфликтуют — непривязанные профили не задеты.
  @@unique([telegramId])
  @@index([role])
  @@index([status])
}

model Course {
  id                            String    @id @default(cuid())
  title                         String
  description                   String?
  startsAt                      DateTime? // начало курса (мероприятия)
  endsAt                        DateTime? // окончание курса (мероприятия)
  scormPath                     String?
  scormVersion                  String? // "1.2" | "2004"
  scormManifest                 String? // JSON: organizations, items, resources (SCO list)
  aiContext                     String? // JSON: extracted text per lesson for LLM
  aiTutorEnabled                Boolean   @default(true) // включён ли AI-тьютор в плеере
  thumbnailUrl                  String?
  /// Формат: scorm — асинхронное обучение (SCORM); live_event — очное мероприятие и/или вебинар по расписанию
  courseFormat                  String    @default("scorm")
  /// Очно: адрес / зал; можно указать «Онлайн» — детали в eventUrl
  eventVenue                    String?
  /// Ссылка на вебинар (Zoom, Teams, TrueConf и т.д.)
  eventUrl                      String?
  status                        String    @default("published") // draft=В разработке, published=Опубликован, cancelled=Отменено, archived=В архиве
  /// Если true — любой вошедший пользователь портала (роль user) видит курс и может проходить без записи (пробный/демо).
  openAccessForAllStudents      Boolean   @default(false)
  price                         Int?
  sortOrder                     Int       @default(0)
  verificationRequiredLessonIds String? // JSON array of lesson identifiers that require phygital verification, e.g. ["lesson-1","lesson-2"]
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  enrollments            Enrollment[]
  certificates           Certificate[]
  scormProgress          ScormProgress[]
  media                  Media[]
  phygitalVerifications  PhygitalVerification[]
  services               Service[]
  courseNotificationSets CourseNotificationSet[]
  certificateTemplates   CertificateTemplate[]
  courseGroups           CourseGroup[]
  scormVersions          ScormVersion[]
  aiTutorConversations   AiTutorConversation[]
}

model ScormVersion {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  scormPath     String
  scormVersion  String?
  scormManifest String?
  aiContext     String?
  fileSize      Int?
  notes         String?
  isActive      Boolean  @default(false)
  uploadedById  String?
  createdAt     DateTime @default(now())

  @@unique([courseId, version])
  @@index([courseId])
}

model AiTutorConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiTutorMessage[]

  @@index([courseId])
  @@index([userId])
}

model AiTutorMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   AiTutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime  @default(now())
  expiresAt    DateTime?
  accessClosed Boolean   @default(false) // false = Открыт, true = Закрыт
  completedAt  DateTime? // если задано — участие Завершено

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([enrolledAt])
}

model ScormProgress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId         String
  cmiData          String?  @default("{}")
  completionStatus String?
  score            Float?
  timeSpent        Int      @default(0)
  lastUpdated      DateTime @updatedAt

  @@unique([userId, courseId, lessonId])
  // Отчёты группируют по courseId (groupBy в reports/by-course, learners,
  // выдача сертификатов). Составной unique выше здесь не работает: courseId в
  // нём не ведущая колонка. ScormProgress растёт как пользователи × курсы ×
  // уроки — это самая быстрорастущая таблица проекта.
  @@index([courseId])
}

model CertificateTemplate {
  id                 String   @id @default(cuid())
  name               String
  backgroundImageUrl String? // подложка PDF/PNG/JPG — загрузка в форме шаблона
  textMapping        String? // JSON координат полей: name, date, courseTitle, certNumber
  courseId           String?
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  minScore           Int?
  requiredStatus     String?
  validityDays       Int?
  numberingFormat    String?
  allowUserDownload  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  certificates Certificate[]

  // Шаблон ищется по courseId (выдача сертификатов, одиночная и массовая), а
  // внешний ключ индексом не покрыт — каждый поиск был полным сканом таблицы.
  @@index([courseId])
}

model Certificate {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  certNumber String               @unique
  pdfUrl     String?
  issuedAt   DateTime             @default(now())
  revokedAt  DateTime?
  expiryDate DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([issuedAt])
}

model Media {
  id            String   @id @default(cuid())
  title         String
  fileUrl       String // для type=link — внешний URL
  thumbnailUrl  String? // обложка/превью (для видео и ссылок)
  mimeType      String?
  category      String?
  description   String?
  type          String   @default("file") // file | link
  viewsCount    Int      @default(0)
  allowDownload Boolean  @default(true)
  ratingSum     Int      @default(0)
  ratingCount   Int      @default(0)
  ownerId       String?
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mediaGroups MediaGroup[]

  @@index([courseId])
  @@index([category])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String   @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  // Список уведомлений студента — выборка по userId с сортировкой по createdAt.
  // Раздельные индексы выше дают только один из двух шагов.
  @@index([userId, createdAt])
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  managerId   String?
  manager     User?    @relation("ManagerTickets", fields: [managerId], references: [id], onDelete: SetNull)
  subject     String
  status      String   @default("open") // open, in_progress, resolved, closed
  messages    String   @default("[]")
  orderNumber String? // при обращении «Нет доступа» — заказ для аналитики (7.4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PhygitalVerification {
  id             String                              @id @default(cuid())
  userId         String
  user           User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course                              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId       String?
  /// video | text — тип задания (текстовые ответы и видео проходят одну очередь проверки)
  assignmentType String                              @default("video")
  videoUrl       String
  status         String                              @default("pending") // pending, approved, rejected
  reviewedBy     String?
  reviewedAt     DateTime?
  comment        String?
  createdAt      DateTime                            @default(now())
  threadComments PhygitalVerificationThreadComment[]

  // Очередь менеджера фильтрует по status/courseId, сортирует по createdAt и
  // считает count тем же условием — без индексов это два полных скана таблицы
  // на каждое открытие очереди и на каждый рендер дашборда.
  @@index([status, createdAt])
  @@index([courseId])
  @@index([userId])
}

/// Переписка по заданию: слушатель и проверяющий (менеджер/админ).
model PhygitalVerificationThreadComment {
  id             String               @id @default(cuid())
  verificationId String
  verification   PhygitalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  authorUserId   String
  author         User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime             @default(now())

  @@index([verificationId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// Журнал интеграции PayKeeper (токен, счёт, webhook). В payload только безопасные поля.
model PaykeeperIntegrationLog {
  id          String   @id @default(cuid())
  direction   String
  event       String
  status      String
  orderNumber String?
  invoiceUrl  String?
  httpStatus  Int?
  message     String?
  payload     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([orderNumber])
  @@index([event])
  @@index([status])
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String?
  body      String // тело с плейсхолдерами %recfirstname%, %reclastname%, %date%, %systemtitle%, %objectname%
  type      String   @default("both") // "internal" | "email" | "both"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationSets NotificationSet[]
}

model NotificationSet {
  id         String                @id @default(cuid())
  eventType  String // enrollment, certificate_issued, enrollment_excluded, access_opened, access_closed, ...
  name       String
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isDefault  Boolean               @default(false)
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  courseLinks CourseNotificationSet[]
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String? // null если пользователь удалён
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String
  subject   String?
  content   String // итоговый текст (срез)
  channel   String // "internal" | "email"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([eventType])
}

model CourseNotificationSet {
  id                String          @id @default(cuid())
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notificationSetId String
  notificationSet   NotificationSet @relation(fields: [notificationSetId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([courseId, notificationSetId])
}

model CommsTemplate {
  id        String   @id @default(cuid())
  name      String
  channel   String // email, telegram
  subject   String?
  htmlBody  String?
  variables String?  @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommsSend {
  id           String   @id @default(cuid())
  templateId   String?
  channel      String
  recipient    String
  subject      String?
  status       String   @default("sent")
  sentAt       DateTime @default(now())
  sentBy       String?
  errorMessage String?
  isTest       Boolean  @default(false)

  // Журнал отправок пишется строкой на каждого получателя каждой рассылки и
  // растёт неограниченно, а админка фильтрует по status/channel/sentAt и
  // сортирует по sentAt — без индексов это скан всей таблицы, дважды.
  @@index([sentAt])
  @@index([status, sentAt])
}

/// Входящая почта (IMAP): ящик админки.
model InboundMailbox {
  id                String    @id @default(cuid())
  label             String
  imapHost          String
  imapPort          Int       @default(993)
  imapTls           Boolean   @default(true)
  username          String
  passwordEnc       String
  folder            String    @default("INBOX")
  lastUid           Int?
  lastSyncedAt      DateTime?
  lastSyncStatus    String?
  lastSyncError     String?
  lastSyncCheckedAt DateTime?
  retentionDays     Int       @default(365)
  enabled           Boolean   @default(true)
  smtpHost          String?
  smtpPort          Int?
  smtpTls           Boolean?  @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages      InboundMessage[]
  domainMailbox DomainMailbox?
}

/// Ящик на домене @avaterra.pro (Mailcow и связь с InboundMailbox для IMAP).
model DomainMailbox {
  id               String          @id @default(cuid())
  email            String          @unique
  localPart        String
  domain           String          @default("avaterra.pro")
  label            String
  status           String          @default("active") // active | suspended
  passwordEnc      String
  provisioningKind String          @default("mailcow") // mailcow | manual
  provisioningRef  String?
  inboundMailboxId String?         @unique
  inboundMailbox   InboundMailbox? @relation(fields: [inboundMailboxId], references: [id], onDelete: SetNull)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([domain])
  @@index([localPart, domain])
}

/// Сообщение, импортированное с IMAP.
model InboundMessage {
  id             String         @id @default(cuid())
  mailboxId      String
  mailbox        InboundMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  imapUid        Int
  messageId      String?
  inReplyTo      String?
  references     String?
  fromAddress    String
  fromName       String?
  toAddresses    String         @default("[]")
  subject        String?
  receivedAt     DateTime
  bodyText       String?
  bodyHtml       String?
  matchedUserId  String?
  matchedUser    User?          @relation(fields: [matchedUserId], references: [id], onDelete: SetNull)
  hasAttachments Boolean        @default(false)
  snippet        String?

  @@unique([mailboxId, imapUid])
  @@index([receivedAt])
  @@index([fromAddress])
  @@index([matchedUserId])
  @@index([mailboxId, receivedAt])
}

/// Общий журнал доставки исходящих писем (без тела письма).
model EmailDeliveryLog {
  id           String   @id @default(cuid())
  module       String
  entityId     String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient    String
  subject      String?
  status       String // sent | failed | skipped
  provider     String // resend | smtp
  direction    String   @default("outbound")
  errorMessage String?
  sentBy       String?
  createdAt    DateTime @default(now())

  @@index([module])
  @@index([entityId])
  @@index([userId])
  @@index([recipient])
  @@index([createdAt])
}

/// Сохранённые API-ключи для LLM (несколько ключей, выбор в настройках чат-бота/тьютора).
model LlmApiKey {
  id              String   @id @default(cuid())
  name            String // например "DeepSeek основной", "OpenAI запасной"
  provider        String // deepseek, openai, anthropic
  apiKeyEncrypted String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  llmSettings LlmSetting[]
}

model LlmSetting {
  id              String     @id @default(cuid())
  key             String     @unique
  provider        String
  model           String
  systemPrompt    String?
  temperature     Float?     @default(0.7)
  maxTokens       Int?       @default(2000)
  apiKeyEncrypted String?
  apiKeyId        String? // если задан — использовать сохранённый ключ
  apiKey          LlmApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([apiKeyId])
}

/// Шаблоны промптов для чат-бота: несколько вариантов, один активный, статистика использования.
model PromptTemplate {
  id         String    @id @default(cuid())
  name       String
  content    String // текст system prompt
  scope      String    @default("chatbot") // chatbot | course-tutor
  isActive   Boolean   @default(false)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  category  String? // general, email, payments, branding
  updatedAt DateTime @updatedAt
}

// Service: товары витрины главной — description/imageUrl для карточки «Купить курс»
model Service {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?
  imageUrl           String?
  price              Int
  paykeeperTariffId  String?
  courseId           String?
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  isActive           Boolean  @default(true)
  installmentEnabled Boolean  @default(false)
  maxInstallments    Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UserEnergy {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int       @default(0)
  level          Int       @default(1)
  lastPracticeAt DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Журнал изменений заряда (геймификация): урок, ручная правка админом.
model GamificationXpEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String // lesson_complete | admin_delta | admin_set
  delta        Int
  balanceAfter Int
  meta         String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Lead {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String
  email             String?
  message           String?
  notes             String? // admin notes
  status            String   @default("new")
  source            String? // form, landing, manual, telegram_bot
  convertedToUserId String?
  lastOrderNumber   String? // при оплате заказа с email лида — для аналитики (1.3)
  /// Диалог в Telegram: заполняется, когда человек сам нажал /start у бота.
  /// Только с ним бот имеет право писать первым — на этом держатся автодогоны.
  telegramChatId    Int?
  telegramUsername  String?
  /// Сегмент воронки бота: info | warm | hot
  funnelSegment     String?
  /// Метка источника из deep link (?start=s-<source>): site-footer, blog, channel…
  entrySource       String?
  /// Сколько догоняющих сообщений уже отправлено (0 — ни одного)
  followupStage     Int      @default(0)
  lastBotMessageAt  DateTime?
  /// Человек ответил боту — догоны прекращаются
  respondedAt       DateTime?
  /// Автоквалификация: когда и почему бот перевёл лид в qualified
  qualifiedAt       DateTime?
  qualifyReason     String?
  /// Обнаружен интент покупки (спросил цену/оплату/запись) — приоритет и оффер
  buyIntentAt       DateTime?
  /// Автономный прогрев: этап сценария (0 — не начат) и время последнего касания
  nurtureStage      Int      @default(0)
  lastNurtureAt     DateTime?
  /// Оффер (тариф + ссылка на оплату) отправлен ботом
  offerSentAt       DateTime?
  /// Человек отписался (/stop) — любые авторассылки прекращаются навсегда
  unsubscribedAt    DateTime?
  /// Аудитория (запрос лида): tense_body | personal_crisis | specialist | spiritual | skeptic
  /// По ней персонализируются оффер и ответы. Определяется из свободных сообщений.
  audience          String?
  /// Дожим после оффера отправлен (одно финальное касание с соц.доказательством)
  offerNudgedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([telegramChatId])
  @@index([followupStage])
  @@index([nurtureStage])
}

model Order {
  id          Int       @id @default(autoincrement())
  orderNumber String    @unique
  tariffId    String
  amount      Int
  clientEmail String
  clientPhone String?
  /// ФИО клиента из формы оплаты (используется в письмах вместо локальной части email).
  clientName  String?
  status      String    @default("pending")
  paidAt      DateTime?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Идентификатор счёта PayKeeper (invoice_id).
  paykeeperInvoiceId  String?
  /// Прямая ссылка на оплату из ответа PayKeeper (invoice_url).
  paykeeperInvoiceUrl String?
  /// Идентификатор платежа PayKeeper после оплаты / сверки.
  paykeeperPaymentId  String?
  /// Нормализованный статус PayKeeper (success, obtained, …).
  paykeeperStatus     String?
  /// Сырой статус / источник последней синхронизации.
  paykeeperRawStatus  String?
  /// Фактически оплаченная сумма (руб., целое), если отличается от amount.
  paidAmountRub       Int?
  /// Уже возвращено через PayKeeper (руб., целое), для учёта частичных возвратов.
  refundedAmountRub   Int       @default(0)
  /// Ключ/идентификатор чека в PayKeeper (если передан).
  receiptKey          String?
  lastSyncedAt        DateTime?

  paykeeperRefunds  PaykeeperRefundRecord[]
  paykeeperReceipts PaykeeperReceiptRecord[]
  paymentLinks      PaymentLink[]
  installmentPlan   InstallmentPlan?

  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@index([paykeeperPaymentId])
  @@index([paykeeperInvoiceId])
  // Поиск заказов клиента по почте: сверка зачислений, привязка заказов при
  // входе, создание тикета. Без индекса это скан всей таблицы заказов.
  @@index([clientEmail])
}

/// Запросы возврата через PayKeeper (/change/payment/reverse/).
model PaykeeperRefundRecord {
  id                 String   @id @default(cuid())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paykeeperPaymentId String
  amountRub          Int
  partial            Boolean  @default(false)
  status             String   @default("requested")
  resultMsg          String?
  rawResponse        String?
  createdAt          DateTime @default(now())

  @@index([orderId])
  @@index([paykeeperPaymentId])
}

/// Снимки данных чеков / ответов API по заказу.
model PaykeeperReceiptRecord {
  id        String   @id @default(cuid())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId String?
  source    String   @default("api")
  payload   String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([paymentId])
}

/// Одноразовый токен для установки/сброса пароля (конвертация лида, восстановление пароля).
model PasswordToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

/// Токен верификации email (48 ч).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Mailing {
  id              String    @id @default(cuid())
  internalTitle   String
  emailSubject    String
  emailBody       String
  senderName      String?
  senderEmail     String?
  status          String    @default("planned") // planned | processing | completed
  scheduleMode    String    @default("manual") // manual | scheduled
  scheduledAt     DateTime?
  recipientConfig String? // JSON: { type: 'all'|'role'|'list', role?: string, userIds?: string[] }
  attachments     String? // JSON: массив { name, pathOrKey, size }
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  logs MailingLog[]
}

model MailingLog {
  id             String    @id @default(cuid())
  mailingId      String
  mailing        Mailing   @relation(fields: [mailingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientEmail String
  recipientName  String?
  status         String // "sent" | "failed"
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([mailingId])
}

model MailingUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Publication {
  id            String   @id @default(cuid())
  title         String
  type          String // "news" | "announcement"
  status        String   @default("active") // "active" | "closed"
  publishAt     DateTime
  teaser        String?
  content       String
  keywords      String?
  viewsCount    Int      @default(0)
  ratingSum     Int      @default(0)
  ratingCount   Int      @default(0)
  allowComments Boolean  @default(true)
  allowRating   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments PublicationComment[]

  @@index([status])
  @@index([publishAt])
}

model PublicationComment {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName    String?
  content       String
  createdAt     DateTime    @default(now())

  @@index([publicationId])
}

/// Журнал фиксации согласий на обработку ПДн и связанных событий (152-ФЗ).
model ConsentLog {
  id          String   @id @default(cuid())
  kind        String
  context     String?
  userId      String?
  emailNorm   String?
  orderNumber String?
  docVersion  String   @default("2026-04-30")
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([emailNorm])
}

// --- SMM / Site Radar (единый Telegram-бот @AvaterraProBot) ---

model BrandProfile {
  id          String   @id @default(cuid())
  slug        String   @unique @default("avaterra")
  kbVersion   String?
  dataJson    String // YAML KB → JSON
  toneOfVoice String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentPlan {
  id        String   @id @default(cuid())
  weekStart DateTime
  weekEnd   DateTime
  status    String   @default("draft") // draft | active | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ContentItem[]

  @@index([weekStart])
}

model ContentItem {
  id              String       @id @default(cuid())
  planId          String?
  plan            ContentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  publishDate     DateTime
  postType        String
  topic           String
  objective       String?
  outline         String?
  cta             String?
  themeId         String?
  theme           ThemePool?   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  audience        String?
  rubric          String?
  generatedText   String?
  finalText       String?
  imageUrl        String?
  imageUrlBackup  String?
  /// planned | generating | quality_failed | dedup_blocked | ready | approved | published | rejected
  status          String       @default("planned")
  qualityIssues   String? // JSON
  dedupSignature  String? // base64 MinHash
  dedupKeywords   String? // JSON string[]
  telegramMsgId   Int?
  publishedAt     DateTime?
  /// Отправлено ли фото поста в канал. Публикация идёт несколькими сообщениями
  /// (фото + части текста), и при обрыве на середине повтор слал бы в канал
  /// начало поста второй раз — подписчики видели дубль.
  publishedPhoto  Boolean      @default(false)
  /// Сколько частей текста уже ушло в канал: повтор продолжает с этого места.
  publishedChunks Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  postStats PostStat[]

  @@index([publishDate])
  @@index([status])
  @@index([planId])
}

model SitePage {
  id         String    @id @default(cuid())
  url        String    @unique
  category   String    @default("other")
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  versions SitePageVersion[]
  signals  SiteSignal[]
}

model SitePageVersion {
  id             String   @id @default(cuid())
  pageId         String
  page           SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contentHash    String
  normalizedJson String? // JSON блоков
  fetchedAt      DateTime @default(now())

  @@index([pageId, fetchedAt])
}

model SiteSignal {
  id         String    @id @default(cuid())
  pageId     String?
  page       SitePage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  signalType String
  changeType String
  score      Int       @default(0)
  severity   String    @default("low")
  summary    String
  payload    String? // JSON
  /// new | processed | ignored
  status     String    @default("new")
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([severity])
  @@index([status])
}

model ThemePool {
  id        String   @id @default(cuid())
  topic     String
  postType  String   @default("educational")
  audience  String?
  rubric    String?
  priority  Int      @default(50)
  /// pending | scheduled | used | rejected
  status    String   @default("pending")
  /// kb | radar | manual
  source    String   @default("kb")
  payload   String? // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ContentItem[]

  @@unique([source, topic])
  @@index([status])
  @@index([postType])
}

model PostStat {
  id            String       @id @default(cuid())
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  telegramMsgId Int?
  channelId     String?
  views         Int          @default(0)
  forwards      Int          @default(0)
  reactions     Int          @default(0)
  rawPayload    String? // JSON
  fetchedAt     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contentItemId])
  @@index([telegramMsgId])
}

// ═══════════════════════════════════════════════════════
// Эпик 1: Персональные товары и платёжные ссылки
// ═══════════════════════════════════════════════════════

/// Персональный товар — разовая услуга, создаваемая админом (консультация, тестирование).
model PersonalProduct {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  priceRub           Int
  /// null = бессрочный; иначе — дата/время истечения ссылки
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  installmentEnabled Boolean   @default(false)
  maxInstallments    Int       @default(3)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  links PaymentLink[]

  @@index([isActive])
  @@index([createdAt])
}

/// Уникальная платёжная ссылка — генерируется для персонального товара.
model PaymentLink {
  id                  String          @id @default(cuid())
  productId           String
  product             PersonalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  token               String          @unique
  /// pending | paid | expired
  status              String          @default("pending")
  clientEmail         String?
  clientName          String?
  userId              String?
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId             Int?
  order               Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paykeeperInvoiceId  String?
  paykeeperInvoiceUrl String?
  createdAt           DateTime        @default(now())
  paidAt              DateTime?

  @@index([token])
  @@index([status])
  @@index([productId])
  @@index([paykeeperInvoiceId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════
// Эпик 2: Рассрочка
// ═══════════════════════════════════════════════════════

/// План рассрочки — привязан к заказу.
model InstallmentPlan {
  id            String    @id @default(cuid())
  orderId       Int       @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalParts    Int
  partAmountRub Int
  /// active | completed | defaulted | cancelled
  status        String    @default("active")
  nextPaymentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments InstallmentPayment[]

  @@index([status])
  @@index([nextPaymentAt])
}

/// Отдельный платёж в рамках рассрочки.
model InstallmentPayment {
  id                 String          @id @default(cuid())
  planId             String
  plan               InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  partNumber         Int
  amountRub          Int
  /// scheduled | paid | failed | overdue
  status             String          @default("scheduled")
  scheduledAt        DateTime
  paidAt             DateTime?
  paykeeperPaymentId String?
  errorMessage       String?
  retryCount         Int             @default(0)
  reminderSent3d     Boolean         @default(false)
  reminderSent1d     Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([planId, partNumber])
  @@index([status])
  @@index([scheduledAt])
}

/// Статья блога сайта.
///
/// До этого статьи жили в файле кода (lib/content/course-lynda-teaser.ts), и
/// добавить новую можно было только правкой исходников с последующим деплоем —
/// то есть блог не мог пополняться без разработчика. Это и было главным
/// ограничением роста поискового трафика.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// Заголовок для поисковой выдачи и вкладки браузера
  title       String
  /// Заголовок на самой странице (может отличаться от title)
  h1          String
  /// Мета-описание для выдачи
  description String
  /// Тело статьи. Формат задаётся полем bodyFormat.
  body        String
  /// paragraphs — JSON-массив абзацев; markdown — текст с разметкой.
  /// Оба поддерживаются намеренно: страница рисует их по-разному, и сведение
  /// к одному формату незаметно изменило бы вид уже опубликованных статей.
  bodyFormat  String    @default("markdown")
  /// Картинка для превью в соцсетях (обычно карточка 1200×630 с текстом).
  ogImage     String?
  /// Иллюстрация, показываемая В САМОЙ статье и в карточке списка.
  /// Отделена от ogImage намеренно: карточка для соцсетей делается с текстом
  /// поверх и в теле статьи смотрится чужеродно.
  coverImage  String?
  /// draft — черновик, виден только в админке; published — на сайте
  status      String    @default("draft")
  publishedAt DateTime?
  /// Откуда взята статья: manual | telegram
  source      String    @default("manual")
  /// Ссылка на исходный пост канала — чтобы не импортировать его дважды
  sourceUrl   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}
